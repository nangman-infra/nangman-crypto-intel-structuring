{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawIntelL0",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::nangman-crypto-dev-intel-crawl-l0-<account-suffix>",
        "arn:aws:s3:::nangman-crypto-dev-intel-crawl-l0-<account-suffix>/*"
      ]
    },
    {
      "Sid": "ReadMarketL1",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::nangman-crypto-dev-market-ingest-l1-<account-suffix>",
        "arn:aws:s3:::nangman-crypto-dev-market-ingest-l1-<account-suffix>/*"
      ]
    },
    {
      "Sid": "WriteIntelL1",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::nangman-crypto-dev-intel-structuring-l1-<account-suffix>",
        "arn:aws:s3:::nangman-crypto-dev-intel-structuring-l1-<account-suffix>/*"
      ]
    },
    {
      "Sid": "InvokeBedrockModels",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
